---
// Layout commun à toutes les pages (prompt 04).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	/** Titre de la page ; absent = page d'accueil. */
	title?: string;
	description?: string;
}

const { title, description = "Site de l'édition PATRIMOINE.EXE / Nantes 001 — ESD Nantes, B3 Design, 2026." } =
	Astro.props;
const nomSite = 'PATRIMOINE.EXE · NTE001';
const titreComplet = title ? `${title} — ${nomSite}` : nomSite;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{titreComplet}</title>
	</head>
	<body>
		<a class="evitement" href="#contenu">Aller au contenu</a>
		<Header />
		<main id="contenu" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
