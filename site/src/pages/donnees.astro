---
// « Nantes en direct » : données vivantes Open Data Nantes Métropole (prompt 11).
// Page statique au build (aucun appel réseau), remplie dans le navigateur par nantes-api.js.
import Layout from '../layouts/Layout.astro';
import { DATASETS } from '../lib/datasets.js';

const live = DATASETS.filter((d) => d.mode === 'live');
const patrimoine = DATASETS.filter((d) => d.mode === 'snapshot');
const groupes = [
	{ id: 'live', titre: 'Temps réel', intro: 'Interrogés depuis votre navigateur et rafraîchis automatiquement.', jeux: live },
	{
		id: 'patrimoine',
		titre: 'Sources patrimoniales',
		intro: 'Jamais interrogées en direct : instantanés d’agrégats enregistrés avec la date de leur collecte.',
		jeux: patrimoine,
	},
];
---

<Layout title="Données" description="Nantes en direct : données ouvertes de Nantes Métropole, avec leur source, leur licence et leur mapping.">
	<h1>Nantes en direct</h1>
	<p class="chapeau">
		Chaque jeu de données est présenté comme une fiche-source : producteur, licence, fréquence et la
		phrase qui justifie sa place dans la chaîne <span class="mono">source → grammaire → système → œuvre</span>.
		Sans réseau, la page affiche les dernières données enregistrées.
	</p>

	<p class="actions">
		<button type="button" class="bouton" data-tout-maj>Tout mettre à jour</button>
	</p>

	<noscript>
		<p class="avertissement">
			JavaScript est désactivé : les valeurs ne peuvent pas être chargées. Les fiches-sources ci-dessous
			restent consultables.
		</p>
	</noscript>

	{
		groupes.map((g) => (
			<section aria-labelledby={`t-${g.id}`} class="groupe">
				<h2 id={`t-${g.id}`}>{g.titre}</h2>
				<p>{g.intro}</p>
				<div class="cartes">
					{g.jeux.map((d) => (
						<article class="carte" data-dataset={d.id} aria-labelledby={`t-${d.code}`}>
							<header>
								<p class="carte__code mono">{d.code}</p>
								<h3 id={`t-${d.code}`}>{d.titre}</h3>
								<p class="badge" aria-live="polite" data-badge>
									<span class="point" aria-hidden="true" />
									<span data-badge-texte>Chargement…</span>
								</p>
							</header>
							<div class="viz" data-viz />
							<p class="mapping">{d.mapping}</p>
							<dl class="meta">
								<dt>Producteur</dt>
								<dd>{d.producteur}</dd>
								<dt>Licence</dt>
								<dd>{d.licence}</dd>
								<dt>Fréquence</dt>
								<dd>{d.frequence}</dd>
								<dt>Jeu</dt>
								<dd>
									<a href={`https://data.nantesmetropole.fr/explore/dataset/${d.id}/`} class="mono">
										{d.id}
									</a>
								</dd>
							</dl>
							{d.mode === 'live' && (
								<button type="button" class="bouton bouton--petit" data-maj>
									Mettre à jour<span class="visuellement-cache"> : {d.titre}</span>
								</button>
							)}
						</article>
					))}
				</div>
			</section>
		))
	}
</Layout>

<script>
	import { DATASETS } from '../lib/datasets.js';
	import { getDataset } from '../lib/nantes-api.js';

	type Resultat = Awaited<ReturnType<typeof getDataset>>;
	const etat = new Map<string, Resultat>();
	const minuteries = new Map<string, number>();

	const el = <K extends keyof HTMLElementTagNameMap>(tag: K, classe?: string, texte?: string) => {
		const n = document.createElement(tag);
		if (classe) n.className = classe;
		if (texte !== undefined) n.textContent = texte; // jamais d'innerHTML avec des données d'API
		return n;
	};

	const dateFr = (v: number | string | null) =>
		v ? new Date(v).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' }) : 'date inconnue';

	function texteBadge(ds: (typeof DATASETS)[number], r: Resultat) {
		if (r.origin === 'indisponible') return 'Données indisponibles';
		if (ds.mode === 'snapshot') return `Instantané du ${dateFr(r.fetchedAt)}`;
		if (r.origin === 'local') return `Données locales du ${dateFr(r.fetchedAt)}`;
		const min = Math.max(0, Math.round((Date.now() - Number(r.fetchedAt)) / 60000));
		return `Données en direct · mis à jour ${min < 1 ? 'à l’instant' : `il y a ${min} min`}`;
	}

	function majBadge(carte: HTMLElement, ds: (typeof DATASETS)[number], r: Resultat) {
		const badge = carte.querySelector<HTMLElement>('[data-badge]')!;
		badge.dataset.origine = ds.mode === 'snapshot' ? 'snapshot' : r.origin === 'cache' ? 'live' : r.origin;
		badge.querySelector('[data-badge-texte]')!.textContent = texteBadge(ds, r);
	}

	function dessiner(carte: HTMLElement, ds: (typeof DATASETS)[number], r: Resultat) {
		const zone = carte.querySelector<HTMLElement>('[data-viz]')!;
		zone.replaceChildren();
		const lignes = ds.lignes(r.records);
		if (!lignes.length) {
			zone.append(el('p', 'vide', 'Aucune donnée à afficher pour le moment.'));
			return;
		}

		if (ds.viz === 'barres') {
			const maxCommun = Math.max(...lignes.map((l) => l.valeur), 1);
			const ul = el('ul', 'barres');
			for (const l of lignes) {
				const li = el('li');
				const max = l.max && l.max > 0 ? l.max : maxCommun;
				const pct = Math.min(100, Math.max(0, (l.valeur / max) * 100));
				const piste = el('span', 'barre');
				piste.setAttribute('aria-hidden', 'true');
				const rempli = el('span', 'barre__rempli');
				rempli.style.width = `${pct}%`;
				piste.append(rempli);
				li.append(el('span', 'barres__label', l.label), piste, el('span', 'barres__val mono', l.detail ?? String(l.valeur)));
				ul.append(li);
			}
			zone.append(ul);
		} else if (ds.viz === 'tableau') {
			const total = lignes.reduce((s, l) => s + l.valeur, 0);
			const table = el('table', 'tableau');
			table.append(el('caption', 'visuellement-cache', `${ds.titre} : nombre de tronçons par état`));
			const thead = el('thead');
			const tr = el('tr');
			for (const t of ['État du trafic', 'Tronçons', 'Part']) {
				const th = el('th', t === 'État du trafic' ? '' : 'nombre', t);
				th.scope = 'col';
				tr.append(th);
			}
			thead.append(tr);
			const tbody = el('tbody');
			for (const l of lignes) {
				const row = el('tr');
				const th = el('th', '', l.label);
				th.scope = 'row';
				row.append(th, el('td', 'nombre', String(l.valeur)), el('td', 'nombre', `${Math.round((l.valeur / total) * 100)} %`));
				tbody.append(row);
			}
			table.append(thead, tbody);
			zone.append(table);
		} else if (ds.viz === 'pastilles') {
			const ul = el('ul', 'pastilles');
			for (const l of lignes) {
				const li = el('li');
				const p = el('span', 'pastille');
				p.setAttribute('aria-hidden', 'true');
				p.style.background = l.couleur ?? 'transparent';
				li.append(p, el('span', 'pastilles__texte', `${dateFr(l.label)} : ${l.detail}`));
				ul.append(li);
			}
			zone.append(ul);
		} else {
			const ul = el('ul', 'liste');
			for (const l of lignes) {
				const li = el('li');
				li.dataset.actif = String(l.valeur > 0 && !/terminée|nulle|pas/i.test(l.detail ?? ''));
				li.append(el('strong', '', l.label), el('span', '', ` — ${l.detail}`));
				ul.append(li);
			}
			zone.append(ul);
		}
	}

	async function charger(id: string, forcer = false) {
		const ds = DATASETS.find((d) => d.id === id)!;
		const carte = document.querySelector<HTMLElement>(`[data-dataset="${id}"]`);
		if (!carte) return;
		carte.setAttribute('aria-busy', 'true');
		const r = await getDataset(id, { forcer });
		etat.set(id, r);
		dessiner(carte, ds, r);
		majBadge(carte, ds, r);
		carte.removeAttribute('aria-busy');
	}

	function demarrerMinuteries() {
		for (const ds of DATASETS) {
			if (ds.mode !== 'live' || minuteries.has(ds.id)) continue;
			minuteries.set(ds.id, window.setInterval(() => charger(ds.id), ds.refreshMs));
		}
	}

	function arreterMinuteries() {
		minuteries.forEach((t) => clearInterval(t));
		minuteries.clear();
	}

	// Premier chargement
	DATASETS.forEach((ds) => charger(ds.id));
	demarrerMinuteries();

	// Pause quand l'onglet est caché ; reprise (avec cache) quand il revient
	document.addEventListener('visibilitychange', () => {
		if (document.hidden) {
			arreterMinuteries();
		} else {
			DATASETS.filter((d) => d.mode === 'live').forEach((d) => charger(d.id));
			demarrerMinuteries();
		}
	});

	// « il y a X min » reste juste entre deux rafraîchissements
	window.setInterval(() => {
		for (const ds of DATASETS) {
			const r = etat.get(ds.id);
			const carte = document.querySelector<HTMLElement>(`[data-dataset="${ds.id}"]`);
			if (r && carte && ds.mode === 'live' && r.origin !== 'local') majBadge(carte, ds, r);
		}
	}, 60000);

	// Boutons
	document.querySelectorAll<HTMLButtonElement>('[data-maj]').forEach((b) => {
		b.addEventListener('click', () => {
			const id = b.closest<HTMLElement>('[data-dataset]')!.dataset.dataset!;
			charger(id, true);
		});
	});
	document.querySelector('[data-tout-maj]')?.addEventListener('click', () => {
		DATASETS.filter((d) => d.mode === 'live').forEach((d) => charger(d.id, true));
	});
</script>

<style>
	.chapeau {
		font-size: var(--t-s);
	}
	.actions {
		margin: var(--e-4) 0;
	}
	.groupe {
		margin-bottom: var(--e-6);
	}
	.cartes {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: var(--e-4);
	}
	.carte {
		display: flex;
		flex-direction: column;
		gap: var(--e-3);
		padding: var(--e-4);
		border: 2px solid var(--c-texte);
		border-radius: var(--r-lg);
	}
	.carte h3 {
		font-size: var(--t-s);
		margin: 0;
	}
	.carte__code {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
		margin: 0;
	}
	.badge {
		display: inline-flex;
		align-items: center;
		gap: var(--e-2);
		margin: var(--e-2) 0 0;
		font-size: 0.875rem;
		font-family: var(--f-mono);
	}
	.point {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--c-filet);
		flex: none;
	}
	.badge[data-origine='live'] .point {
		background: var(--c-tertiaire);
		animation: respire 2.4s ease-in-out infinite;
	}
	.badge[data-origine='local'] .point,
	.badge[data-origine='snapshot'] .point {
		background: var(--c-primaire);
	}
	.badge[data-origine='indisponible'] .point {
		background: var(--c-texte);
	}
	@keyframes respire {
		50% {
			opacity: 0.35;
		}
	}
	.mapping {
		font-size: var(--t-petit);
		border-left: 4px solid var(--c-tertiaire);
		padding-left: var(--e-3);
		margin: 0;
	}
	.meta {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 2px var(--e-3);
		margin: 0;
		font-size: 0.875rem;
	}
	.meta dt {
		color: var(--c-texte-doux);
	}
	.meta dd {
		margin: 0;
		overflow-wrap: anywhere;
	}
	.carte [data-maj] {
		align-self: flex-start;
		margin-top: auto;
	}

	/* Visualisations (générées en JS : :global) */
	.viz :global(.barres),
	.viz :global(.pastilles),
	.viz :global(.liste) {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--e-2);
		font-size: 0.875rem;
	}
	.viz :global(.barres li) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 2px var(--e-2);
	}
	.viz :global(.barre) {
		grid-column: 1 / -1;
		height: 8px;
		background: var(--c-fond-alt);
		border-radius: var(--r-sm);
		overflow: hidden;
		order: 3;
	}
	.viz :global(.barre__rempli) {
		display: block;
		height: 100%;
		background: var(--c-primaire);
	}
	.viz :global(.barres__val) {
		color: var(--c-texte-doux);
	}
	.viz :global(.pastilles li) {
		display: flex;
		align-items: center;
		gap: var(--e-2);
		font-size: var(--t-petit);
	}
	.viz :global(.pastille) {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		border: 1px solid var(--c-texte);
		flex: none;
	}
	.viz :global(.liste li[data-actif='false']) {
		color: var(--c-texte-doux);
	}
	.viz :global(.vide) {
		color: var(--c-texte-doux);
		font-size: var(--t-petit);
	}
	.viz :global(.tableau) {
		font-size: 0.875rem;
	}

	.bouton {
		font: inherit;
		font-size: var(--t-petit);
		padding: var(--e-2) var(--e-3);
		border: 2px solid var(--c-texte);
		border-radius: var(--r-md);
		background: var(--c-fond);
		color: var(--c-texte);
		cursor: pointer;
	}
	.bouton:hover {
		background: var(--c-texte);
		color: var(--c-fond);
	}
	.bouton--petit {
		font-size: 0.875rem;
		padding: var(--e-1) var(--e-3);
	}
	.avertissement {
		padding: var(--e-3);
		background: var(--c-fond-alt);
		border-radius: var(--r-md);
	}
	@media (prefers-reduced-motion: reduce) {
		.badge[data-origine='live'] .point {
			animation: none;
		}
	}
</style>
