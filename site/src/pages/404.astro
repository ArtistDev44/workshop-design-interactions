---
// Page 404 personnalisée (prompt 08).
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Page introuvable">
	<p class="code mono">Erreur 404</p>
	<h1>Page introuvable</h1>
	<p>Cette page n’existe pas, ou pas encore, dans l’édition PATRIMOINE.EXE / Nantes 001.</p>
	<p>
		<a href={base}>Revenir à l’accueil</a> · <a href={`${base}oeuvres/`}>Voir les œuvres</a>
	</p>
</Layout>

<style>
	.code {
		color: var(--c-texte-doux);
		font-size: var(--t-petit);
	}
</style>
