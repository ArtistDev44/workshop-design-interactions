---
import { lien } from '../lib/liens';
// Page d'accueil (URL /) : le jeu de l'édition, « Nantes en régulation ».
// Textes issus du registre (src/content/oeuvres/) : aucun contenu inventé.
import Layout from '../layouts/Layout.astro';
import { getOeuvres, lienJouable } from '../lib/oeuvres';

const oeuvres = await getOeuvres();
const jeu = oeuvres.find((o) => lienJouable(o));
const jouer = jeu ? lienJouable(jeu) : null;
const jauges = jeu ? jeu.data.grammaire.invariants.filter((i) => i.includes('jauge')) : [];
const actions = jeu ? jeu.data.grammaire.invariants.find((i) => i.includes('actions')) : null;
const seuil = jeu ? jeu.data.grammaire.invariants.find((i) => i.includes('Seuil')) : null;
const inventaire = jeu ? jeu.data.grammaire.invariants.find((i) => i.includes('inventé')) : null;
---

<Layout title="Jeu" description="Nantes en régulation, le jeu de l'édition PATRIMOINE.EXE / Nantes 001 : rejouez une semaine réelle du réseau Naolib, dossier par dossier.">
	<section class="hero-jeu" aria-labelledby="titre-jeu">
		<p class="hero-jeu__surtitre mono">{jeu ? jeu.data.id : 'PXE-NTE001-G01-W01'}</p>
		<h1 id="titre-jeu">{jeu ? jeu.data.titre.toUpperCase() : 'NANTES EN RÉGULATION'}</h1>
		<p class="hero-jeu__accroche">
			Salle de contrôle des transports nantais : rejouez une semaine réelle du réseau Naolib.
			Chaque incident tiré des données réelles devient un dossier à trancher sous la pression d'un compteur.
		</p>
		{jouer && (
			<p class="hero-jeu__actions">
				<a class="bouton-principal" href={jouer}>
					JOUER À « {jeu ? jeu.data.titre : 'Nantes en régulation'} » →
				</a>
			</p>
		)}
	</section>

	{jeu && (
		<section aria-labelledby="titre-regles">
			<h2 id="titre-regles">Les règles du jeu</h2>
			<ul class="regles">
				{seuil && <li>{seuil}.</li>}
				{actions && <li>{actions}.</li>}
				{jauges.length > 0 && <li>{jauges[0]}.</li>}
				{inventaire && <li>{inventaire}.</li>}
			</ul>
			<p class="hero-jeu__fallback">{jeu.data.fallback}</p>
		</section>
	)}

	<section aria-labelledby="titre-pitch">
		<h2 id="titre-pitch">Le pitch</h2>
		<p>{jeu ? jeu.data.cartel : ''}</p>
	</section>
</Layout>

<style>
	section {
		margin-bottom: var(--e-6);
	}
	.hero-jeu {
		border: 4px solid var(--c-texte);
		padding: var(--e-5);
		background: var(--c-fond-alt);
	}
	.hero-jeu__surtitre {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
		margin-bottom: var(--e-2);
	}
	.hero-jeu h1 {
		font-size: var(--t-xxl);
		line-height: 0.95;
		margin-bottom: var(--e-3);
	}
	.hero-jeu__accroche {
		font-size: var(--t-s);
		max-width: 60ch;
	}
	.hero-jeu__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--e-3);
		margin: 0;
	}
	.bouton-principal {
		padding: var(--e-3) var(--e-5);
		background: var(--c-primaire);
		color: var(--c-fond);
		text-decoration: none;
		font-weight: 700;
		font-size: var(--t-s);
		border: 3px solid var(--c-texte);
	}
	.bouton-principal:hover {
		background: var(--c-texte);
		color: var(--c-fond);
	}
	.regles {
		padding-left: var(--e-4);
		font-size: var(--t-base);
	}
	.regles li {
		margin-bottom: var(--e-2);
	}
	.hero-jeu__fallback {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}
</style>
