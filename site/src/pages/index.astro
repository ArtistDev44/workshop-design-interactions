---
import { lien } from '../lib/liens';
// Page d'accueil de l'édition NTE001 (prompt 05) : brutaliste pleine largeur, grille bento.
// Textes issus du framework PATRIMOINE.EXE et de todo.md : aucun contenu inventé.
import Layout from '../layouts/Layout.astro';
import edition from '../data/edition.json';
import { getOeuvres, lienJouable, slugDe } from '../lib/oeuvres';

const jouables = (await getOeuvres()).filter((o) => lienJouable(o));
const jeu = jouables[0] ?? null;
const urlEnLigne = new URL(lien(), Astro.site).href;

const compteurs = [
	{ valeur: edition.compteurs.villes_activees, label: 'ville activée' },
	{ valeur: edition.compteurs.institutions_hotes, label: 'institution hôte' },
	{ valeur: edition.compteurs.oeuvres_publiques, label: 'œuvre publique' },
];

const chaine = ['Source', 'Grammaire', 'Système', 'Œuvre'];

// Principes de l'édition, dans l'ordre de todo.md
const principes = [
	'Une source réelle avant un style.',
	'Un système stable avant une technologie supplémentaire.',
	'Un mapping justifié avant une API.',
	'Une œuvre exposable avant une démonstration de code.',
];

const appels = [
	{ href: 'jeu/', titre: 'LE JEU', texte: 'Nantes en régulation, jouable maintenant.', span: 'appel--large' },
	{ href: 'oeuvres/', titre: 'ŒUVRES', texte: 'La galerie des œuvres de l’édition.', span: 'appel--large' },
	{ href: 'catalogue/', titre: 'CATALOGUE', texte: 'L’archive complète, œuvre par œuvre.', span: 'appel--etroit' },
	{ href: 'methode/', titre: 'MÉTHODE', texte: 'Le protocole PATRIMOINE.EXE en 10 étapes.', span: 'appel--tres-large' },
];
---

<Layout pleineLargeur>
	<div class="bento">
		<section class="cellule cellule--hero" aria-labelledby="titre-edition">
			<p class="hero__surtitre mono">
				{edition.edition} · {edition.host} · {edition.type}
			</p>
			<h1 id="titre-edition">
				<span>PATRIMOINE.EXE</span>
				<span class="hero__ville">{edition.city.toUpperCase()} {edition.numero}</span>
			</h1>
			<p class="hero__infos">
				Édition pilote · {edition.programme} · 9, 10 &amp; 12 novembre {edition.year}
			</p>
		</section>

		{
			jeu && (
				<section class="cellule cellule--jeu" aria-labelledby="titre-jeu">
					<p class="jeu__etiquette mono">LE JEU DE L'ÉDITION · {jeu.data.id}</p>
					<h2 id="titre-jeu">{jeu.data.titre.toUpperCase()}</h2>
					<p class="jeu__texte">
						Salle de contrôle des transports nantais : rejouez une semaine réelle du réseau Naolib,
						dossier par dossier. Aucun événement inventé.
					</p>
					<p class="jeu__actions">
						<a class="btn btn--inverse" href={lienJouable(jeu)}>JOUER →</a>
						<a class="btn" href={lien('jeu/')}>LA PAGE DU JEU →</a>
						<a class="btn" href={lien(slugDe(jeu))}>LIRE LE CARTEL →</a>
					</p>
				</section>
			)
		}

		<section class="cellule cellule--manifeste" aria-labelledby="titre-manifeste">
			<h2 id="titre-manifeste" class="manifeste__titre">MANIFESTE</h2>
			<blockquote lang="fr">
				<p>
					« Le patrimoine n’est pas une banque de formes à copier, mais un ensemble de structures,
					de savoirs, de gestes et de mémoires que l’on peut étudier, formaliser et reprogrammer. »
				</p>
			</blockquote>
			<blockquote lang="en" class="manifeste__en">
				<p>
					“Heritage is not a bank of forms to copy, but a set of structures, knowledge, gestures
					and memories that can be studied, formalized and reprogrammed.”
				</p>
			</blockquote>
			<p class="manifeste__source">— Framework PATRIMOINE.EXE</p>
		</section>

		{
			compteurs.map((c) => (
				<section class="cellule cellule--compteur" aria-label={c.label}>
					<span class="compteur__valeur">{c.valeur}</span>
					<span class="compteur__label">{c.label}</span>
				</section>
			))
		}

		<section class="cellule cellule--chaine" aria-labelledby="titre-chaine">
			<h2 id="titre-chaine" class="chaine__titre">LA CHAÎNE À TENIR</h2>
			<ol class="chaine__liste">
				{
					chaine.map((c, i) => (
						<li class={i < 2 ? 'etape--large' : 'etape--etroit'}>
							<span class="chaine__num mono">0{i + 1}</span>
							<span class="chaine__etape">{c.toUpperCase()}</span>
						</li>
					))
				}
			</ol>
			<ul class="principes">
				{principes.map((p) => <li>{p}</li>)}
			</ul>
		</section>

		{
			appels.map((a) => (
				<a class={`cellule cellule--appel ${a.span}`} href={lien(a.href)}>
					<span class="appel__titre">{a.titre} →</span>
					<span class="appel__texte">{a.texte}</span>
				</a>
			))
		}

		<section class="cellule cellule--qr" aria-labelledby="titre-qr">
			<h2 id="titre-qr" class="qr__titre">LE SITE EN LIGNE</h2>
			<img
				src={lien(`assets/qr-edition.png`)}
				alt="QR code vers le site en ligne de l’édition PATRIMOINE.EXE / Nantes 001"
				width="180"
				height="180"
			/>
			<p class="mono qr__url">{urlEnLigne}</p>
		</section>
	</div>
</Layout>

<style>
	/* Brutaliste pleine largeur, grille bento : cases de tailles différentes,
	   bords noirs pleins, ombres dures. Contraste ≥ 4,5:1 conservé
	   (blanc sur noir, blanc sur --c-primaire 5,9:1, noir sur blanc). */
	.bento {
		display: grid;
		grid-template-columns: 1fr;
		grid-auto-rows: minmax(0, auto);
		grid-auto-flow: dense;
		gap: var(--e-2);
	}

	.cellule {
		border: 4px solid var(--c-texte);
		box-shadow: 8px 8px 0 var(--c-texte);
		padding: var(--e-4);
		background: var(--c-fond);
		min-width: 0;
	}

	h1, h2 {
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}

	/* Héros : noir plein, pleine largeur */
	.cellule--hero {
		grid-column: 1 / -1;
		background: var(--c-texte);
		color: var(--c-fond);
		padding: var(--e-5);
	}
	.hero__surtitre {
		font-size: var(--t-petit);
		text-transform: uppercase;
		margin-bottom: var(--e-2);
	}
	.cellule--hero h1 {
		font-size: var(--t-xxl);
		line-height: 0.9;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--e-2);
		margin-bottom: var(--e-3);
	}
	.hero__ville {
		background: var(--c-primaire);
		color: var(--c-fond);
		padding: 0 var(--e-3);
	}
	.hero__infos {
		font-size: var(--t-s);
		font-weight: 600;
		margin: 0;
	}

	/* Bannière du jeu : bleu plein, grande case */
	.cellule--jeu {
		background: var(--c-primaire);
		color: var(--c-fond);
		padding: var(--e-5);
		display: flex;
		flex-direction: column;
	}
	.jeu__etiquette {
		font-size: var(--t-petit);
		text-transform: uppercase;
		margin-bottom: var(--e-2);
	}
	.cellule--jeu h2 {
		font-size: var(--t-xxl);
		line-height: 0.95;
		margin-bottom: var(--e-3);
	}
	.jeu__texte {
		font-size: var(--t-s);
		max-width: 60ch;
	}
	.jeu__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--e-3);
		margin: auto 0 0;
		padding-top: var(--e-3);
	}
	.btn {
		display: inline-block;
		padding: var(--e-3) var(--e-5);
		border: 4px solid var(--c-texte);
		background: var(--c-fond);
		color: var(--c-texte);
		text-decoration: none;
		font-weight: 700;
		font-size: var(--t-s);
		text-transform: uppercase;
		box-shadow: 6px 6px 0 var(--c-texte);
	}
	.btn:hover {
		transform: translate(2px, 2px);
		box-shadow: 4px 4px 0 var(--c-texte);
	}
	.btn--inverse {
		background: var(--c-texte);
		color: var(--c-fond);
	}

	/* Manifeste */
	.manifeste__titre {
		font-size: var(--t-m);
		border-bottom: 4px solid var(--c-texte);
		padding-bottom: var(--e-2);
		margin-bottom: var(--e-3);
	}
	blockquote {
		margin: 0 0 var(--e-3);
	}
	blockquote p {
		font-family: var(--f-titre);
		font-size: var(--t-s);
		font-weight: 600;
		line-height: 1.15;
		text-transform: uppercase;
		margin: 0;
	}
	.manifeste__en p {
		font-size: var(--t-petit);
		text-transform: none;
		font-style: italic;
		font-weight: 400;
		color: var(--c-texte-doux);
	}
	.manifeste__source {
		font-size: var(--t-petit);
		font-family: var(--f-mono);
		margin: 0;
	}

	/* Compteurs : petites cases carrées */
	.cellule--compteur {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.compteur__valeur {
		font-family: var(--f-titre);
		font-size: var(--t-xl);
		font-weight: 700;
		line-height: 1;
	}
	.compteur__label {
		font-size: var(--t-petit);
		text-transform: uppercase;
	}

	/* Chaîne : grande case pleine largeur, étapes internes de tailles variées */
	.cellule--chaine {
		grid-column: 1 / -1;
	}
	.chaine__titre {
		font-size: var(--t-l);
		border-bottom: 6px solid var(--c-texte);
		padding-bottom: var(--e-2);
		margin-bottom: var(--e-4);
	}
	.chaine__liste {
		list-style: none;
		margin: 0 0 var(--e-4);
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--e-2);
	}
	.chaine__liste li {
		border: 4px solid var(--c-texte);
		padding: var(--e-3);
		display: flex;
		flex-direction: column;
		gap: var(--e-1);
	}
	.chaine__num {
		font-size: var(--t-petit);
	}
	.chaine__etape {
		font-family: var(--f-titre);
		font-size: var(--t-m);
		font-weight: 700;
		color: var(--c-primaire);
	}
	.principes {
		margin: 0;
		padding: var(--e-3);
		border: 4px solid var(--c-texte);
		font-size: var(--t-petit);
		list-style: none;
	}
	.principes li {
		padding: var(--e-1) 0;
		border-bottom: 2px solid var(--c-filet);
	}
	.principes li:last-child {
		border-bottom: none;
	}
	.principes li::before {
		content: '■ ';
		color: var(--c-primaire);
	}

	/* Appels : cases de largeurs différentes */
	.cellule--appel {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--e-2);
		text-decoration: none;
		color: var(--c-texte);
	}
	.cellule--appel:hover {
		background: var(--c-primaire);
		color: var(--c-fond);
		transform: translate(2px, 2px);
		box-shadow: 6px 6px 0 var(--c-texte);
	}
	.appel__titre {
		font-family: var(--f-titre);
		font-size: var(--t-l);
		font-weight: 700;
	}
	.appel__texte {
		font-size: var(--t-petit);
	}

	/* QR : case pleine largeur horizontale */
	.cellule--qr {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--e-4);
	}
	.qr__titre {
		font-size: var(--t-m);
		margin: 0;
	}
	.cellule--qr img {
		border: 3px solid var(--c-texte);
	}
	.qr__url {
		font-size: var(--t-petit);
		overflow-wrap: anywhere;
		margin: 0;
	}

	/* Tablette : 4 colonnes */
	@media (min-width: 720px) {
		.bento {
			grid-template-columns: repeat(4, 1fr);
		}
		.cellule--jeu { grid-column: span 3; grid-row: span 2; }
		.cellule--manifeste { grid-column: span 1; grid-row: span 2; }
		.cellule--compteur { grid-column: span 2; }
		.etape--large { grid-column: span 2; }
		.etape--etroit { grid-column: span 2; }
		.chaine__liste { grid-template-columns: repeat(4, 1fr); }
		.appel--large { grid-column: span 2; }
		.appel--etroit { grid-column: span 1; }
		.appel--tres-large { grid-column: span 3; }
	}

	/* Desktop : 6 colonnes, cases encore plus variées */
	@media (min-width: 1100px) {
		.bento {
			grid-template-columns: repeat(6, 1fr);
		}
		.cellule--jeu { grid-column: span 4; }
		.cellule--manifeste { grid-column: span 2; }
		.cellule--compteur { grid-column: span 2; }
		.chaine__liste { grid-template-columns: repeat(6, 1fr); }
		.etape--large { grid-column: span 2; }
		.etape--etroit { grid-column: span 1; }
		.appel--large { grid-column: span 3; }
		.appel--etroit { grid-column: span 2; }
		.appel--tres-large { grid-column: span 4; }
	}
</style>
