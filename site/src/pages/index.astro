---
import { lien } from '../lib/liens';
// Page d'accueil de l'édition NTE001 (prompt 05), refondue en style brutaliste.
// Textes issus du framework PATRIMOINE.EXE et de todo.md : aucun contenu inventé.
import Layout from '../layouts/Layout.astro';
import edition from '../data/edition.json';
import { getOeuvres, lienJouable, slugDe } from '../lib/oeuvres';

const jouables = (await getOeuvres()).filter((o) => lienJouable(o));
const jeu = jouables[0] ?? null;
const urlEnLigne = new URL(lien(), Astro.site).href;

const compteurs = [
	{ valeur: edition.compteurs.villes_activees, label: 'ville activée' },
	{ valeur: edition.compteurs.institutions_hotes, label: 'institution hôte' },
	{ valeur: edition.compteurs.oeuvres_publiques, label: 'œuvre publique' },
];

const chaine = ['Source', 'Grammaire', 'Système', 'Œuvre'];

// Principes de l'édition, dans l'ordre de todo.md
const principes = [
	'Une source réelle avant un style.',
	'Un système stable avant une technologie supplémentaire.',
	'Un mapping justifié avant une API.',
	'Une œuvre exposable avant une démonstration de code.',
];

const appels = [
	{ href: 'jeu/', titre: 'LE JEU', texte: 'Nantes en régulation, jouable maintenant.' },
	{ href: 'oeuvres/', titre: 'ŒUVRES', texte: 'La galerie des œuvres de l’édition.' },
	{ href: 'catalogue/', titre: 'CATALOGUE', texte: 'L’archive complète, œuvre par œuvre.' },
	{ href: 'methode/', titre: 'MÉTHODE', texte: 'Le protocole PATRIMOINE.EXE en 10 étapes.' },
];
---

<Layout>
	<section class="hero" aria-labelledby="titre-edition">
		<p class="hero__surtitre mono">
			{edition.edition} · {edition.host} · {edition.type}
		</p>
		<h1 id="titre-edition">
			<span>PATRIMOINE.EXE</span>
			<span class="hero__ville">{edition.city.toUpperCase()} {edition.numero}</span>
		</h1>
		<p class="hero__infos">
			Édition pilote · {edition.programme} · 9, 10 &amp; 12 novembre {edition.year}
		</p>
	</section>

	{
		jeu && (
			<section class="jeu-banner" aria-labelledby="titre-jeu">
				<p class="jeu-banner__etiquette mono">LE JEU DE L'ÉDITION · {jeu.data.id}</p>
				<h2 id="titre-jeu">{jeu.data.titre.toUpperCase()}</h2>
				<p class="jeu-banner__texte">
					Salle de contrôle des transports nantais : rejouez une semaine réelle du réseau Naolib,
					dossier par dossier. Aucun événement inventé.
				</p>
				<p class="jeu-banner__actions">
					<a class="btn btn--primaire" href={lienJouable(jeu)}>
						JOUER →
					</a>
					<a class="btn" href={lien('jeu/')}>
						LA PAGE DU JEU →
					</a>
					<a class="btn" href={lien(slugDe(jeu))}>
						LIRE LE CARTEL →
					</a>
				</p>
			</section>
		)
	}

	<section class="manifeste" aria-labelledby="titre-manifeste">
		<h2 id="titre-manifeste" class="visuellement-cache">Manifeste</h2>
		<blockquote lang="fr">
			<p>
				« Le patrimoine n’est pas une banque de formes à copier, mais un ensemble de structures,
				de savoirs, de gestes et de mémoires que l’on peut étudier, formaliser et reprogrammer. »
			</p>
		</blockquote>
		<blockquote lang="en" class="manifeste__en">
			<p>
				“Heritage is not a bank of forms to copy, but a set of structures, knowledge, gestures
				and memories that can be studied, formalized and reprogrammed.”
			</p>
		</blockquote>
		<p class="manifeste__source">— Framework PATRIMOINE.EXE</p>
	</section>

	<section aria-labelledby="titre-compteurs">
		<h2 id="titre-compteurs" class="visuellement-cache">L’édition en chiffres</h2>
		<ul class="compteurs">
			{
				compteurs.map((c) => (
					<li>
						<span class="compteurs__valeur">{c.valeur}</span>
						<span class="compteurs__label">{c.label}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="chaine" aria-labelledby="titre-chaine">
		<h2 id="titre-chaine">LA CHAÎNE À TENIR</h2>
		<ol class="chaine__liste">
			{
				chaine.map((c, i) => (
					<li>
						<span class="chaine__num mono">0{i + 1}</span>
						<span class="chaine__etape">{c.toUpperCase()}</span>
					</li>
				))
			}
		</ol>
		<ul class="principes">
			{principes.map((p) => <li>{p}</li>)}
		</ul>
	</section>

	<nav class="appels" aria-label="Explorer l’édition">
		{
			appels.map((a) => (
				<a class="appel" href={lien(a.href)}>
					<span class="appel__titre">{a.titre} →</span>
					<span class="appel__texte">{a.texte}</span>
				</a>
			))
		}
	</nav>

	<section class="qr-edition" aria-labelledby="titre-qr">
		<h2 id="titre-qr">LE SITE EN LIGNE</h2>
		<img
			src={lien(`assets/qr-edition.png`)}
			alt="QR code vers le site en ligne de l’édition PATRIMOINE.EXE / Nantes 001"
			width="180"
			height="180"
		/>
		<p class="mono">{urlEnLigne}</p>
	</section>
</Layout>

<style>
	/* Brutalisme : bords noirs pleins, ombres dures sans flou, angles droits,
	   capitales. Contraste conservé ≥ 4,5:1 (noir/blanc, blanc sur --c-primaire 5,9:1). */
	section {
		margin-bottom: var(--e-6);
	}

	h1, h2 {
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}

	/* Héros */
	.hero {
		border: 6px solid var(--c-texte);
		box-shadow: 12px 12px 0 var(--c-texte);
		padding: var(--e-5);
		margin-bottom: var(--e-6);
	}
	.hero__surtitre {
		font-size: var(--t-petit);
		text-transform: uppercase;
		margin-bottom: var(--e-2);
	}
	.hero h1 {
		font-size: var(--t-xxl);
		line-height: 0.9;
		display: flex;
		flex-direction: column;
		margin-bottom: var(--e-3);
	}
	.hero__ville {
		background: var(--c-primaire);
		color: var(--c-fond);
		align-self: flex-start;
		padding: 0 var(--e-3);
	}
	.hero__infos {
		font-size: var(--t-s);
		font-weight: 600;
		margin: 0;
	}

	/* Bannière du jeu */
	.jeu-banner {
		border: 6px solid var(--c-texte);
		background: var(--c-primaire);
		color: var(--c-fond);
		box-shadow: 12px 12px 0 var(--c-texte);
		padding: var(--e-5);
	}
	.jeu-banner__etiquette {
		font-size: var(--t-petit);
		text-transform: uppercase;
		margin-bottom: var(--e-2);
	}
	.jeu-banner h2 {
		font-size: var(--t-xxl);
		line-height: 0.95;
		margin-bottom: var(--e-3);
	}
	.jeu-banner__texte {
		font-size: var(--t-s);
		max-width: 60ch;
	}
	.jeu-banner__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--e-3);
		margin: 0;
	}
	.btn {
		display: inline-block;
		padding: var(--e-3) var(--e-5);
		border: 4px solid var(--c-texte);
		background: var(--c-fond);
		color: var(--c-texte);
		text-decoration: none;
		font-weight: 700;
		font-size: var(--t-s);
		text-transform: uppercase;
		box-shadow: 6px 6px 0 var(--c-texte);
	}
	.btn:hover {
		transform: translate(2px, 2px);
		box-shadow: 4px 4px 0 var(--c-texte);
	}
	.btn--primaire {
		background: var(--c-texte);
		color: var(--c-fond);
	}

	/* Manifeste */
	.manifeste {
		border: 4px solid var(--c-texte);
		padding: var(--e-4);
	}
	blockquote {
		margin: 0 0 var(--e-3);
	}
	blockquote p {
		font-family: var(--f-titre);
		font-size: var(--t-m);
		font-weight: 600;
		line-height: 1.15;
		text-transform: uppercase;
		max-width: 40ch;
		margin: 0;
	}
	.manifeste__en p {
		font-size: var(--t-s);
		text-transform: none;
		font-style: italic;
		font-weight: 400;
		color: var(--c-texte-doux);
	}
	.manifeste__source {
		font-size: var(--t-petit);
		font-family: var(--f-mono);
		margin: 0;
	}

	/* Compteurs */
	.compteurs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: var(--e-4);
	}
	.compteurs li {
		border: 4px solid var(--c-texte);
		padding: var(--e-3);
		box-shadow: 8px 8px 0 var(--c-texte);
		display: flex;
		flex-direction: column;
	}
	.compteurs__valeur {
		font-family: var(--f-titre);
		font-size: var(--t-xl);
		font-weight: 700;
		line-height: 1;
	}
	.compteurs__label {
		font-size: var(--t-petit);
		text-transform: uppercase;
	}

	/* Chaîne source → grammaire → système → œuvre */
	.chaine h2 {
		border-bottom: 6px solid var(--c-texte);
		padding-bottom: var(--e-2);
	}
	.chaine__liste {
		list-style: none;
		margin: 0 0 var(--e-4);
		padding: 0;
		display: grid;
		gap: var(--e-4);
	}
	.chaine__liste li {
		border: 4px solid var(--c-texte);
		padding: var(--e-3);
		display: flex;
		flex-direction: column;
		gap: var(--e-1);
		box-shadow: 8px 8px 0 var(--c-texte);
	}
	.chaine__num {
		font-size: var(--t-petit);
	}
	.chaine__etape {
		font-family: var(--f-titre);
		font-size: var(--t-m);
		font-weight: 700;
		color: var(--c-primaire);
	}
	@media (min-width: 720px) {
		.chaine__liste {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.principes {
		margin: 0;
		padding: var(--e-3);
		border: 4px solid var(--c-texte);
		font-size: var(--t-petit);
		list-style: none;
	}
	.principes li {
		padding: var(--e-1) 0;
		border-bottom: 2px solid var(--c-filet);
	}
	.principes li:last-child {
		border-bottom: none;
	}
	.principes li::before {
		content: '■ ';
		color: var(--c-primaire);
	}

	/* Appels */
	.appels {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--e-4);
	}
	.appel {
		display: flex;
		flex-direction: column;
		gap: var(--e-1);
		padding: var(--e-4);
		border: 4px solid var(--c-texte);
		box-shadow: 8px 8px 0 var(--c-texte);
		text-decoration: none;
		color: var(--c-texte);
	}
	.appel:hover {
		background: var(--c-primaire);
		color: var(--c-fond);
		transform: translate(2px, 2px);
		box-shadow: 6px 6px 0 var(--c-texte);
	}
	.appel__titre {
		font-family: var(--f-titre);
		font-size: var(--t-l);
		font-weight: 700;
	}
	.appel__texte {
		font-size: var(--t-petit);
	}

	/* QR code de l'édition */
	.qr-edition {
		border: 4px solid var(--c-texte);
		padding: var(--e-4);
		display: grid;
		justify-items: start;
		gap: var(--e-2);
	}
	.qr-edition h2 {
		font-size: var(--t-m);
		margin: 0;
	}
	.qr-edition img {
		border: 3px solid var(--c-texte);
	}
	.qr-edition p {
		font-size: var(--t-petit);
		overflow-wrap: anywhere;
		margin: 0;
	}
</style>
