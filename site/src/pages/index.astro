---
// Page d'accueil de l'édition NTE001 (prompt 05).
// Textes issus du framework PATRIMOINE.EXE et de todo.md : aucun contenu inventé.
import Layout from '../layouts/Layout.astro';
import edition from '../data/edition.json';
import { getOeuvres, lienJouable, slugDe } from '../lib/oeuvres';

const base = import.meta.env.BASE_URL;
const jouables = (await getOeuvres()).filter((o) => lienJouable(o));
const urlEnLigne = new URL(base, Astro.site).href;

const compteurs = [
	{ valeur: edition.compteurs.villes_activees, label: 'ville activée' },
	{ valeur: edition.compteurs.institutions_hotes, label: 'institution hôte' },
	{ valeur: edition.compteurs.oeuvres_publiques, label: 'œuvre publique' },
];

const chaine = ['Source', 'Grammaire', 'Système', 'Œuvre'];

// Principes de l'édition, dans l'ordre de todo.md
const principes = [
	'Une source réelle avant un style.',
	'Un système stable avant une technologie supplémentaire.',
	'Un mapping justifié avant une API.',
	'Une œuvre exposable avant une démonstration de code.',
];

const appels = [
	{ href: 'oeuvres/', titre: 'Œuvres', texte: 'La galerie des œuvres de l’édition.' },
	{ href: 'catalogue/', titre: 'Catalogue', texte: 'L’archive complète, œuvre par œuvre.' },
	{ href: 'methode/', titre: 'Méthode', texte: 'Le protocole PATRIMOINE.EXE en 10 étapes.' },
];
---

<Layout>
	<section class="edition" aria-labelledby="titre-edition">
		<p class="edition__surtitre mono">
			{edition.edition} · {edition.host} · {edition.type}
		</p>
		<h1 id="titre-edition">
			<span>PATRIMOINE.EXE</span>
			<span class="edition__ville">{edition.city.toUpperCase()} {edition.numero}</span>
		</h1>
		<p class="edition__infos">
			Édition pilote · {edition.programme} · 9, 10 &amp; 12 novembre {edition.year}
		</p>
	</section>

	<section class="manifeste" aria-labelledby="titre-manifeste">
		<h2 id="titre-manifeste" class="visuellement-cache">Manifeste</h2>
		<blockquote lang="fr">
			<p>
				« Le patrimoine n’est pas une banque de formes à copier, mais un ensemble de structures,
				de savoirs, de gestes et de mémoires que l’on peut étudier, formaliser et reprogrammer. »
			</p>
		</blockquote>
		<blockquote lang="en" class="manifeste__en">
			<p>
				“Heritage is not a bank of forms to copy, but a set of structures, knowledge, gestures
				and memories that can be studied, formalized and reprogrammed.”
			</p>
		</blockquote>
		<p class="manifeste__source">— Framework PATRIMOINE.EXE</p>
	</section>

	<section aria-labelledby="titre-compteurs">
		<h2 id="titre-compteurs" class="visuellement-cache">L’édition en chiffres</h2>
		<ul class="compteurs">
			{
				compteurs.map((c) => (
					<li>
						<span class="compteurs__valeur">{c.valeur}</span>
						<span class="compteurs__label">{c.label}</span>
					</li>
				))
			}
		</ul>
	</section>

	{
		jouables.length > 0 && (
			<section class="jouer" aria-labelledby="titre-jouer">
				<h2 id="titre-jouer">Jouer maintenant</h2>
				<ul class="jouer__liste">
					{jouables.map((o) => (
						<li class="jouer__item">
							<div>
								<p class="jouer__id mono">{o.data.id}</p>
								<p class="jouer__titre">{o.data.titre}</p>
								<p class="jouer__texte">
									{o.data.stack.split(',')[0]} · <a href={`${base}${slugDe(o)}/`}>lire le cartel</a>
								</p>
							</div>
							<a class="jouer__bouton" href={lienJouable(o)}>
								Jouer<span class="visuellement-cache"> à « {o.data.titre} »</span> →
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="chaine" aria-labelledby="titre-chaine">
		<h2 id="titre-chaine">La chaîne à tenir</h2>
		<ol class="chaine__liste">
			{
				chaine.map((c, i) => (
					<li>
						<span class="chaine__num mono">0{i + 1}</span>
						<span class="chaine__etape">{c}</span>
					</li>
				))
			}
		</ol>
		<ul class="principes">
			{principes.map((p) => <li>{p}</li>)}
		</ul>
	</section>

	<nav class="appels" aria-label="Explorer l’édition">
		{
			appels.map((a) => (
				<a class="appel" href={`${base}${a.href}`}>
					<span class="appel__titre">{a.titre} →</span>
					<span class="appel__texte">{a.texte}</span>
				</a>
			))
		}
	</nav>

	<section class="qr-edition" aria-labelledby="titre-qr">
		<h2 id="titre-qr">Le site en ligne</h2>
		<img
			src={`${base}assets/qr-edition.png`}
			alt="QR code vers le site en ligne de l’édition PATRIMOINE.EXE / Nantes 001"
			width="180"
			height="180"
		/>
		<p class="mono">{urlEnLigne}</p>
	</section>
</Layout>

<style>
	section {
		margin-bottom: var(--e-6);
	}

	/* En-tête éditorial */
	.edition__surtitre {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
		margin-bottom: var(--e-2);
	}
	.edition h1 {
		font-size: var(--t-xxl);
		line-height: 0.95;
		display: flex;
		flex-direction: column;
		margin-bottom: var(--e-3);
	}
	.edition__ville {
		color: var(--c-primaire);
	}
	.edition__infos {
		font-size: var(--t-s);
	}

	/* Manifeste */
	.manifeste {
		border-left: 6px solid var(--c-tertiaire);
		padding-left: var(--e-4);
	}
	blockquote {
		margin: 0 0 var(--e-3);
	}
	blockquote p {
		font-family: var(--f-titre);
		font-size: var(--t-m);
		line-height: 1.2;
		max-width: 40ch;
		margin: 0;
	}
	.manifeste__en p {
		font-size: var(--t-s);
		color: var(--c-texte-doux);
		font-style: italic;
	}
	.manifeste__source {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}

	/* Compteurs */
	.compteurs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: var(--e-3);
	}
	.compteurs li {
		border-top: 4px solid var(--c-primaire);
		padding-top: var(--e-2);
		display: flex;
		flex-direction: column;
	}
	.compteurs__valeur {
		font-family: var(--f-titre);
		font-size: var(--t-xl);
		font-weight: 700;
		line-height: 1;
	}
	.compteurs__label {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}

	/* Jouer maintenant */
	.jouer__liste {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--e-3);
	}
	.jouer__item {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--e-3);
		padding: var(--e-4);
		background: var(--c-fond-alt);
		border-left: 6px solid var(--c-primaire);
		border-radius: var(--r-md);
	}
	.jouer__item p {
		margin: 0;
	}
	.jouer__id,
	.jouer__texte {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}
	.jouer__titre {
		font-family: var(--f-titre);
		font-size: var(--t-l);
		font-weight: 600;
		line-height: 1.1;
	}
	.jouer__bouton {
		padding: var(--e-3) var(--e-5);
		background: var(--c-primaire);
		color: var(--c-fond);
		border-radius: var(--r-md);
		text-decoration: none;
		font-weight: 600;
		font-size: var(--t-s);
	}
	.jouer__bouton:hover {
		background: var(--c-texte);
		color: var(--c-fond);
	}

	/* Chaîne source → grammaire → système → œuvre */
	.chaine__liste {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--e-3);
		counter-reset: none;
	}
	.chaine__liste li {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--e-1);
		padding: var(--e-3);
		background: var(--c-fond-alt);
		border-radius: var(--r-md);
	}
	.chaine__num {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}
	.chaine__etape {
		font-family: var(--f-titre);
		font-size: var(--t-m);
		font-weight: 600;
		color: var(--c-primaire);
	}
	.principes {
		margin: var(--e-4) 0 0;
		padding-left: var(--e-4);
		font-size: var(--t-petit);
	}
	@media (min-width: 720px) {
		.chaine__liste {
			grid-template-columns: repeat(4, 1fr);
		}
		/* Flèches entre les étapes, décoratives (non lues) */
		.chaine__liste li:not(:last-child)::after {
			content: '→';
			position: absolute;
			right: calc(var(--e-3) * -1);
			top: 50%;
			transform: translate(50%, -50%);
			font-size: var(--t-m);
			color: var(--c-tertiaire);
			z-index: 1;
		}
	}

	/* QR code de l'édition */
	.qr-edition {
		margin-top: var(--e-6);
		display: grid;
		justify-items: start;
		gap: var(--e-2);
	}
	.qr-edition h2 {
		font-size: var(--t-m);
		margin: 0;
	}
	.qr-edition p {
		font-size: var(--t-petit);
		overflow-wrap: anywhere;
		margin: 0;
	}

	/* Appels */
	.appels {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--e-3);
	}
	.appel {
		display: flex;
		flex-direction: column;
		gap: var(--e-1);
		padding: var(--e-4);
		border: 2px solid var(--c-texte);
		border-radius: var(--r-lg);
		text-decoration: none;
		color: var(--c-texte);
		transition: background-color var(--transition), color var(--transition);
	}
	.appel:hover {
		background: var(--c-primaire);
		color: var(--c-fond);
	}
	.appel__titre {
		font-family: var(--f-titre);
		font-size: var(--t-m);
		font-weight: 600;
	}
	.appel__texte {
		font-size: var(--t-petit);
	}
</style>
