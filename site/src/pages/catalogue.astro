---
// Catalogue exhaustif de l'édition, consultable comme archive (prompt 09).
// Données locales uniquement : collection « oeuvres ».
import Layout from '../layouts/Layout.astro';
import edition from '../data/edition.json';
import { getOeuvres, slugDe, libelleStatut } from '../lib/oeuvres';

const oeuvres = await getOeuvres();
const base = import.meta.env.BASE_URL;
---

<Layout title="Catalogue" description="Catalogue complet des œuvres de l'édition PATRIMOINE.EXE / Nantes 001.">
	<h1>Catalogue</h1>
	<p>
		Archive de l’édition {edition.edition} : toutes les œuvres du registre, avec leur source
		patrimoniale et les droits associés. {oeuvres.length} œuvre{oeuvres.length > 1 ? 's' : ''} au
		total.
	</p>

	<div class="tableau-defile">
		<table class="tableau">
			<caption>Œuvres de l’édition {edition.edition}</caption>
			<thead>
				<tr>
					<th scope="col">Identifiant</th>
					<th scope="col">Titre</th>
					<th scope="col">Auteurs</th>
					<th scope="col">Statut</th>
					<th scope="col">Source patrimoniale</th>
					<th scope="col">Droits</th>
				</tr>
			</thead>
			<tbody>
				{
					oeuvres.length ? (
						oeuvres.map((o) => (
							<tr>
								<td class="mono">{o.data.id}</td>
								<th scope="row">
									<a href={`${base}${slugDe(o)}/`}>{o.data.titre}</a>
								</th>
								<td>{o.data.auteurs.join(', ')}</td>
								<td>{libelleStatut(o.data.statut)}</td>
								<td>
									<a href={o.data.source.url}>{o.data.source.titre}</a>
									<br />
									<span class="lieu">{o.data.source.lieu}</span>
								</td>
								<td>{o.data.source.droits}</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="6">Aucune œuvre n’est encore inscrite au registre.</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>
</Layout>

<style>
	.lieu {
		color: var(--c-texte-doux);
	}
	.tableau {
		min-width: 860px;
	}
</style>
