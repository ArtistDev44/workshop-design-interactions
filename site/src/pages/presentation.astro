---
// Présentation (prompt 61) : diaporama généré au build depuis slides.md (racine du dépôt), une slide par
// section séparée par « --- ». Pixel Design System (prompt 39). Sans JavaScript, toutes les slides restent
// lisibles les unes sous les autres ; avec, une slide à la fois (← / →, boutons, sommaire).
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const md = readFileSync(resolve(process.cwd(), '../slides.md'), 'utf8'); // npm run build se lance dans site/
const echapper = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const enLigne = (s) =>
	echapper(s)
		.replace(/`([^`]+)`/g, '<code>$1</code>')
		.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
		.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (m, t, u) => `<a href="${u}"${/^https?:/.test(u) ? ' rel="noopener"' : ''}>${t}</a>`);
/** Markdown minimal : titres #, listes -, paragraphes, gras, code, liens */
function rendre(bloc) {
	const lignes = bloc.trim().split('\n');
	let html = '';
	let liste = false;
	let titre = '';
	for (const l of lignes) {
		if (/^- /.test(l)) {
			if (!liste) (html += '<ul>'), (liste = true);
			html += `<li>${enLigne(l.slice(2))}</li>`;
			continue;
		}
		if (liste) (html += '</ul>'), (liste = false);
		if (/^# /.test(l)) {
			titre = l.slice(2);
			html += `<h2>${enLigne(titre)}</h2>`;
		} else if (l.trim()) html += `<p>${enLigne(l)}</p>`;
	}
	if (liste) html += '</ul>';
	return { titre, html };
}
const slides = md.split(/\n---\n/).map(rendre);
const titrePage = 'Présentation — Nantes en régulation · PATRIMOINE.EXE NTE001';
const description = `Présentation du projet « Nantes en régulation » en ${slides.length} slides : question, chaîne source → grammaire → système → œuvre, sources réelles, règles, interactions, livrables.`;
---
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titrePage}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="canonical" href="https://workshop-design-interactions.pages.dev/presentation/" />
		<meta name="theme-color" content="#0d0c0c" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={titrePage} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://workshop-design-interactions.pages.dev/presentation/" />
		<meta property="og:image" content="https://workshop-design-interactions.pages.dev/og-image.jpg" />
		<style is:global>
			/* Pixel Design System : fond #0D0C0C, primaire #D4031C, blanc, arrondi 0, JetBrains Mono / Bitsy Pixels */
			:root { color-scheme: dark; --fond: #0d0c0c; --panneau: #171616; --texte: #ffffff; --doux: rgba(255, 255, 255, 0.78); --primaire: #d4031c; --bord: rgba(255, 255, 255, 0.15); }
			* { box-sizing: border-box; border-radius: 0; }
			body { margin: 0; background: var(--fond); color: var(--texte); font: 1.125rem/1.6 'JetBrains Mono', ui-monospace, monospace; }
			a { color: var(--texte); text-decoration-color: var(--primaire); text-decoration-thickness: 2px; text-underline-offset: 3px; }
			a:focus-visible, button:focus-visible { outline: 3px solid var(--texte); outline-offset: 3px; }
			header, footer { max-width: 72rem; margin: 0 auto; padding: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: center; }
			header p { margin: 0; color: var(--doux); }
			main { max-width: 72rem; margin: 0 auto; padding: 0 1rem; }
			.slide { background: var(--panneau); border: 2px solid var(--bord); border-left: 8px solid var(--primaire); padding: clamp(1.25rem, 4vw, 3.5rem); margin: 1.5rem 0; min-height: min(70vh, 40rem); }
			.slide h2 { font-family: 'Bitsy Pixels', 'JetBrains Mono', ui-monospace, monospace; font-size: clamp(1.75rem, 4.5vw, 3.25rem); line-height: 1.15; margin: 0 0 1.5rem; }
			.slide p, .slide li { font-size: clamp(1.05rem, 2vw, 1.4rem); }
			.slide ul { padding-left: 1.25rem; }
			.slide li { margin: 0.5rem 0; }
			.slide li::marker { color: var(--primaire); }
			.slide strong { color: var(--texte); background: rgba(212, 3, 28, 0.35); padding: 0 0.2em; }
			code { font-size: 0.92em; background: rgba(255, 255, 255, 0.08); padding: 0 0.25em; }
			.num { font-size: 0.95rem; color: var(--doux); margin: 0 0 0.75rem; }
			nav.commandes { position: sticky; bottom: 0; background: var(--fond); border-top: 2px solid var(--bord); padding: 0.75rem 1rem; display: none; gap: 0.75rem; align-items: center; justify-content: center; flex-wrap: wrap; }
			button { font: 700 1rem 'JetBrains Mono', ui-monospace, monospace; color: var(--texte); background: var(--primaire); border: 2px solid var(--primaire); padding: 0.75rem 1.25rem; min-height: 48px; cursor: pointer; }
			button.contour { background: transparent; border-color: var(--texte); }
			button:disabled { opacity: 0.45; cursor: default; }
			details { max-width: 72rem; margin: 0 auto 1rem; padding: 0 1rem; }
			summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; }
			ol.sommaire { columns: 2 16rem; }
			/* Diaporama (JavaScript actif) : une slide à la fois */
			.js .slide { display: none; }
			.js .slide.visible { display: block; }
			.js nav.commandes { display: flex; }
			@media (prefers-reduced-motion: no-preference) { .js .slide.visible { animation: entree 200ms ease-out; } }
			@keyframes entree { from { opacity: 0; transform: translateY(8px); } }
		</style>
	</head>
	<body>
		<header>
			<p><a href="/">← Jouer</a></p>
			<p><a href="/cartel/">Cartel</a></p>
			<p><a href="/making-of/">Making-of</a></p>
			<p>Diaporama généré depuis <code>slides.md</code> · ← / → pour naviguer</p>
		</header>
		<details>
			<summary>Sommaire ({slides.length} slides)</summary>
			<ol class="sommaire">{slides.map((s, i) => <li><a href={'#slide-' + (i + 1)} data-aller={i}>{s.titre}</a></li>)}</ol>
		</details>
		<main>
			{slides.map((s, i) => (
				<section class="slide" id={'slide-' + (i + 1)} aria-label={`Slide ${i + 1} sur ${slides.length} : ${s.titre}`}>
					<p class="num">{i + 1} / {slides.length}</p>
					<Fragment set:html={s.html} />
				</section>
			))}
		</main>
		<nav class="commandes" aria-label="Navigation du diaporama">
			<button type="button" class="contour" id="precedent">← Précédente</button>
			<span id="compteur" aria-live="polite">1 / {slides.length}</span>
			<button type="button" id="suivant">Suivante →</button>
		</nav>
		<script is:inline>
			(() => {
				const slides = [...document.querySelectorAll('.slide')];
				if (!slides.length) return;
				document.documentElement.classList.add('js');
				const compteur = document.getElementById('compteur');
				const prec = document.getElementById('precedent');
				const suiv = document.getElementById('suivant');
				let i = Math.max(0, slides.findIndex((s) => '#' + s.id === location.hash));
				const montrer = (n, focus) => {
					i = Math.max(0, Math.min(slides.length - 1, n));
					slides.forEach((s, k) => s.classList.toggle('visible', k === i));
					compteur.textContent = i + 1 + ' / ' + slides.length;
					prec.disabled = i === 0;
					suiv.disabled = i === slides.length - 1;
					history.replaceState(null, '', '#' + slides[i].id);
					if (focus) slides[i].focus({ preventScroll: true });
				};
				slides.forEach((s) => s.setAttribute('tabindex', '-1'));
				prec.addEventListener('click', () => montrer(i - 1));
				suiv.addEventListener('click', () => montrer(i + 1));
				document.querySelectorAll('[data-aller]').forEach((a) =>
					a.addEventListener('click', (e) => {
						e.preventDefault();
						montrer(Number(a.dataset.aller), true);
					}),
				);
				document.addEventListener('keydown', (e) => {
					if (e.target.closest && e.target.closest('summary, input, textarea')) return;
					if (e.key === 'ArrowRight' || e.key === 'PageDown') montrer(i + 1);
					else if (e.key === 'ArrowLeft' || e.key === 'PageUp') montrer(i - 1);
					else if (e.key === 'Home') montrer(0);
					else if (e.key === 'End') montrer(slides.length - 1);
				});
				montrer(i);
			})();
		</script>
	</body>
</html>
