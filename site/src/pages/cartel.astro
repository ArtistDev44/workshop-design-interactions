---
// Cartel de l'œuvre servi hors du jeu (prompt 33, section 6) : /cartel/
// Seule page Astro du site : le jeu reste public/index.html, servi à la racine.
// Les données viennent du registre validé au build (src/content/oeuvres/, content.config.ts) :
// rien n'est saisi ici, un champ inconnu reste « [À COMPLÉTER] » dans la fiche JSON.
import { getCollection } from 'astro:content';

const oeuvres = (await getCollection('oeuvres')).map((o) => o.data);
const titre = 'Cartels — PATRIMOINE.EXE · NTE001';
---
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titre}</title>
		<meta name="description" content="Cartels des œuvres de l'édition PATRIMOINE.EXE · NTE001, générés depuis le registre." />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href="https://workshop-design-interactions.pages.dev/cartel/" />
		<meta name="theme-color" content="#0d0c0c" />
		<link rel="stylesheet" href="/fonts.css" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={titre} />
		<meta property="og:description" content="Cartels des œuvres de l'édition PATRIMOINE.EXE · NTE001, générés depuis le registre." />
		<meta property="og:url" content="https://workshop-design-interactions.pages.dev/cartel/" />
		<meta property="og:image" content="https://workshop-design-interactions.pages.dev/og-image.jpg" />
		<meta name="twitter:card" content="summary_large_image" />
		<style>
			:root { color-scheme: light; --texte: #000000; --fond: #ffffff; --lien: #005ae1; --trait: #5c5c5c; }
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--fond); color: var(--texte); font: 1.0625rem/1.55 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace; } /* Pixel DS §1.3 */
			main { max-width: 46rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
			a { color: var(--lien); }
			a:focus-visible { outline: 3px solid var(--texte); outline-offset: 2px; }
			article { border-top: 2px solid var(--texte); padding-top: 1rem; margin-top: 2rem; }
			h1, h2, h3 { font-family: 'Bitsy Pixels', 'JetBrains Mono', ui-monospace, monospace; } /* Pixel DS §1.3 : titres en Bitsy Pixels */
			h1 { font-size: 1.75rem; line-height: 1.2; }
			h2 { font-size: 1.375rem; margin: 0 0 .25rem; }
			.id { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .9375rem; color: var(--trait); margin: 0; }
			dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; }
			dt { font-weight: 600; }
			dd { margin: 0; overflow-wrap: anywhere; }
			figure { margin: 1rem 0; }
			figure img, video { display: block; width: 100%; height: auto; border: 1px solid var(--trait); }
			figcaption { font-size: .9375rem; color: var(--trait); margin-top: .25rem; }
			.qr { display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-start; }
			.qr figure { width: 10rem; margin: 0; }
			@media (max-width: 30rem) { dl { grid-template-columns: 1fr; } dd { margin-bottom: .5rem; } }
		</style>
	</head>
	<body>
		<main>
			<p><a href="/">← Jouer à « Nantes en régulation »</a></p>
			<h1>Cartels de l'édition PATRIMOINE.EXE · NTE001</h1>
			<p>ESD Nantes, B3 Design, 9, 10 &amp; 12 novembre 2026. Fiches générées depuis le registre du dépôt (<code>site/src/content/oeuvres/</code>).</p>
			{oeuvres.map((o) => (
				<article>
					<h2>{o.titre}</h2>
					<p class="id">{o.id} · {o.statut}</p>
					<p>{o.cartel}</p>
					<dl>
						<dt>Auteurs</dt><dd>{o.auteurs.join(', ')}</dd>
						<dt>Groupe</dt><dd>{o.groupe}</dd>
						<dt>Source</dt><dd><a href={o.source.url}>{o.source.titre}</a> — {o.source.lieu} (consultée le {o.source.date_acces})</dd>
						<dt>Droits</dt><dd>{o.source.droits}</dd>
						<dt>Règle</dt><dd>{o.grammaire.regle}</dd>
						<dt>Système</dt><dd>{o.stack}</dd>
						<dt>Hors ligne</dt><dd>{o.fallback}</dd>
						{o.id === 'PXE-NTE001-G01-W01' && (<Fragment><dt>Icônes</dt><dd><a href="https://lucide.dev/">Lucide</a>, licence ISC (<a href="/licences/lucide-LICENSE.txt">texte de la licence</a>) — sous-ensemble copié dans le dépôt, sans CDN</dd></Fragment>)}
						<dt>Manifest</dt><dd><a href="/manifest.json">manifest.json</a> (modèle du livret, annexe C)</dd>
						<dt>Making-of</dt><dd><a href="/making-of/">La chaîne des prompts</a></dd>
						<dt>Présentation</dt><dd><a href="/presentation/">Le projet en slides</a></dd>
					</dl>
					{o.id === 'PXE-NTE001-G01-W01' && (
						<section aria-labelledby="captation">
							<h3 id="captation">Captation (vrai rendu du jeu, 1920 × 1080)</h3>
							<figure>
								<img src="/captures/hero.jpg" width="1920" height="1080" loading="lazy" alt="Le poste de régulation en pixel art : en haut les jauges fluidité, réputation et budget, les priorités et l'objectif du jour ; à gauche le menu des applis (Carte, Mails, Community, Journal, Données) ; au centre le dossier 1 / 16 « Affluence supposée · Gravité moyenne » d'un événement réel de l'agenda (Ateliers parents-enfants), la plainte de l'usager et trois répliques avec leurs tendances sur les jauges ; à droite les équipes à glisser sur la carte ; horloge en pause à 10 h 00." />
								<figcaption>hero.jpg — un signalement réel ouvert au poste : trois répliques, les équipes à droite.</figcaption>
							</figure>
							<figure>
								<img src="/captures/detail-01.jpg" width="1920" height="1080" loading="lazy" alt="L'appli Mails : colonne Boîte de réception, catégories et Archives avec leurs compteurs ; liste des mails de la Direction de la régulation groupés sous « Aujourd'hui » ; à droite la consigne du jour ouverte (5 dossiers attendus le 14/09/2026, objectif fluidité ≥ 40, budget 60) et la zone Répondre avec deux réponses rapides." />
								<figcaption>detail-01.jpg — l'appli Mails : consigne du jour et messages de la direction.</figcaption>
							</figure>
							<figure>
								<img src="/captures/process.jpg" width="1920" height="1080" loading="lazy" alt="Le rapport hebdomadaire papier de la semaine 1 (14 au 20 septembre 2026), tamponné « À surveiller » : score 185 sur 300, jauges fluidité, réputation et budget, décisions clés et courbe des jauges décision par décision." />
								<figcaption>process.jpg — le rapport papier de fin de semaine (mode histoire).</figcaption>
							</figure>
							<figure>
								<video src="/captures/demo.mp4" controls muted playsinline preload="none" poster="/captures/thumb.jpg" width="1280" height="720"></video>
								<figcaption>demo.mp4 — 29 s d'une vraie partie, du menu au rapport de la semaine, sans son (enregistrement automatisé, accéléré × 1,25).</figcaption>
							</figure>
							<div class="qr">
								<figure><img src="/assets/qr-edition.png" width="164" height="164" alt="QR code vers le jeu : workshop-design-interactions.pages.dev" /><figcaption>Le jeu</figcaption></figure>
								<figure><img src="/assets/qr-pxe-nte001-g01-w01.png" width="164" height="164" alt="QR code vers cette page de cartels" /><figcaption>Ce cartel</figcaption></figure>
							</div>
						</section>
					)}
				</article>
			))}
		</main>
	</body>
</html>
