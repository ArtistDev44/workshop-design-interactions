---
// Cartel de l'œuvre servi hors du jeu (prompt 33, section 6) : /cartel/
// Seule page Astro du site : le jeu reste public/index.html, servi à la racine.
// Les données viennent du registre validé au build (src/content/oeuvres/, content.config.ts) :
// rien n'est saisi ici, un champ inconnu reste « [À COMPLÉTER] » dans la fiche JSON.
import { getCollection } from 'astro:content';

const oeuvres = (await getCollection('oeuvres')).map((o) => o.data);
const titre = 'Cartels — PATRIMOINE.EXE · NTE001';
---
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titre}</title>
		<meta name="description" content="Cartels des œuvres de l'édition PATRIMOINE.EXE · NTE001, générés depuis le registre." />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href="https://workshop-design-interactions.pages.dev/cartel/" />
		<meta name="theme-color" content="#0d0c0c" />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={titre} />
		<meta property="og:description" content="Cartels des œuvres de l'édition PATRIMOINE.EXE · NTE001, générés depuis le registre." />
		<meta property="og:url" content="https://workshop-design-interactions.pages.dev/cartel/" />
		<meta property="og:image" content="https://workshop-design-interactions.pages.dev/og-image.jpg" />
		<meta name="twitter:card" content="summary_large_image" />
		<style>
			:root { color-scheme: light; --texte: #000000; --fond: #ffffff; --lien: #005ae1; --trait: #5c5c5c; }
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--fond); color: var(--texte); font: 1.0625rem/1.55 system-ui, sans-serif; }
			main { max-width: 46rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
			a { color: var(--lien); }
			a:focus-visible { outline: 3px solid var(--texte); outline-offset: 2px; }
			article { border-top: 2px solid var(--texte); padding-top: 1rem; margin-top: 2rem; }
			h1 { font-size: 1.75rem; line-height: 1.2; }
			h2 { font-size: 1.375rem; margin: 0 0 .25rem; }
			.id { font-family: ui-monospace, monospace; font-size: .9375rem; color: var(--trait); margin: 0; }
			dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; }
			dt { font-weight: 600; }
			dd { margin: 0; overflow-wrap: anywhere; }
			@media (max-width: 30rem) { dl { grid-template-columns: 1fr; } dd { margin-bottom: .5rem; } }
		</style>
	</head>
	<body>
		<main>
			<p><a href="/">← Jouer à « Nantes en régulation »</a></p>
			<h1>Cartels de l'édition PATRIMOINE.EXE · NTE001</h1>
			<p>ESD Nantes, B3 Design, 9, 10 &amp; 12 novembre 2026. Fiches générées depuis le registre du dépôt (<code>site/src/content/oeuvres/</code>).</p>
			{oeuvres.map((o) => (
				<article>
					<h2>{o.titre}</h2>
					<p class="id">{o.id} · {o.statut}</p>
					<p>{o.cartel}</p>
					<dl>
						<dt>Auteurs</dt><dd>{o.auteurs.join(', ')}</dd>
						<dt>Groupe</dt><dd>{o.groupe}</dd>
						<dt>Source</dt><dd><a href={o.source.url}>{o.source.titre}</a> — {o.source.lieu} (consultée le {o.source.date_acces})</dd>
						<dt>Droits</dt><dd>{o.source.droits}</dd>
						<dt>Règle</dt><dd>{o.grammaire.regle}</dd>
						<dt>Système</dt><dd>{o.stack}</dd>
						<dt>Hors ligne</dt><dd>{o.fallback}</dd>
					</dl>
				</article>
			))}
		</main>
	</body>
</html>
