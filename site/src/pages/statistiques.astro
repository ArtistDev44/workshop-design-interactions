---
// Statistiques générées depuis les métadonnées du registre (prompt 09).
// Données locales uniquement : edition.json + collection « oeuvres ».
import Layout from '../layouts/Layout.astro';
import edition from '../data/edition.json';
import { getOeuvres, libelleStatut } from '../lib/oeuvres';

const oeuvres = await getOeuvres();
const A_COMPLETER = '[À COMPLÉTER]';

const statuts = (['STUDENT', 'SELECTED', 'COLLECTION'] as const).map((s) => ({
	label: libelleStatut(s),
	n: oeuvres.filter((o) => o.data.statut === s).length,
}));

const modesLabels = { generative: 'Génératif', data: 'Data', interactif: 'Interactif' } as const;
const modes = (Object.keys(modesLabels) as (keyof typeof modesLabels)[]).map((m) => ({
	label: modesLabels[m],
	n: oeuvres.filter((o) => o.data.mode === m).length,
}));

const groupesConnus = new Set(oeuvres.map((o) => o.data.groupe).filter((g) => g !== A_COMPLETER));
const groupesInconnus = oeuvres.filter((o) => o.data.groupe === A_COMPLETER).length;
const sources = new Set(oeuvres.map((o) => o.data.source.titre));
const datasets = [...new Set([...edition.datasets, ...oeuvres.flatMap((o) => o.data.datasets ?? [])])].sort();

const synthese = [
	{ label: 'Œuvres au registre', n: oeuvres.length },
	{ label: 'Groupes identifiés', n: groupesConnus.size, note: groupesInconnus ? `${groupesInconnus} œuvre(s) sans numéro de groupe renseigné` : '' },
	{ label: 'Sources patrimoniales', n: sources.size },
	{ label: 'Jeux de données référencés', n: datasets.length },
];
---

<Layout title="Statistiques" description="Statistiques de l'édition PATRIMOINE.EXE / Nantes 001, générées depuis le registre.">
	<h1>Statistiques</h1>
	<p>
		Chiffres calculés au moment de la construction du site, à partir du registre de l’édition{' '}
		{edition.edition} : ils évoluent avec chaque œuvre ajoutée.
	</p>

	<div class="tableau-defile">
		<table class="tableau">
			<caption>Synthèse de l’édition</caption>
			<thead>
				<tr><th scope="col">Indicateur</th><th scope="col" class="nombre">Nombre</th><th scope="col">Remarque</th></tr>
			</thead>
			<tbody>
				{
					synthese.map((l) => (
						<tr>
							<th scope="row">{l.label}</th>
							<td class="nombre">{l.n}</td>
							<td>{l.note ?? ''}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<div class="tableau-defile">
		<table class="tableau">
			<caption>Œuvres par statut curatorial</caption>
			<thead>
				<tr><th scope="col">Statut</th><th scope="col" class="nombre">Œuvres</th></tr>
			</thead>
			<tbody>
				{
					statuts.map((s) => (
						<tr>
							<th scope="row">{s.label}</th>
							<td class="nombre">{s.n}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<div class="tableau-defile">
		<table class="tableau">
			<caption>Modes utilisés</caption>
			<thead>
				<tr><th scope="col">Mode</th><th scope="col" class="nombre">Œuvres</th></tr>
			</thead>
			<tbody>
				{
					modes.map((m) => (
						<tr>
							<th scope="row">{m.label}</th>
							<td class="nombre">{m.n}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	<div class="tableau-defile">
		<table class="tableau">
			<caption>Jeux de données référencés</caption>
			<thead>
				<tr><th scope="col">Identifiant (Open Data Nantes Métropole)</th></tr>
			</thead>
			<tbody>
				{
					datasets.length ? (
						datasets.map((d) => (
							<tr>
								<td>
									<a href={`https://data.nantesmetropole.fr/explore/dataset/${d}/`} class="mono">
										{d}
									</a>
								</td>
							</tr>
						))
					) : (
						<tr>
							<td>Aucun jeu de données référencé pour l’instant.</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>
</Layout>
