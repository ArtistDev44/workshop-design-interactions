---
// Méthode : le CORE du framework (prompt 10).
// Textes repris du framework PATRIMOINE.EXE et du livret étudiant Nantes 001 — rien d'inventé.
import Layout from '../layouts/Layout.astro';

const etapes = [
	'Observer',
	'Documenter',
	'Décomposer',
	'Formaliser',
	'Coder',
	'Connecter',
	'Tester',
	'Éditer',
	'Exposer',
	'Archiver',
];

const regimes = [
	{ regime: 'Statique généré', logique: 'Une composition est calculée puis figée.', question: 'Pourquoi générer plusieurs variantes ?' },
	{ regime: 'Évolution lente', logique: 'Le système dérive sans rupture.', question: 'Quelle durée révèle la logique ?' },
	{ regime: 'Événement', logique: 'Une condition provoque une mutation.', question: 'Qu’est-ce qui déclenche réellement un changement ?' },
	{ regime: 'Interaction continue', logique: 'Le visiteur module en temps réel.', question: 'L’utilisateur comprend-il le lien action-effet ?' },
];

const invariants = [
	{ titre: 'Source réelle & provenance', texte: 'Une source située, sourcée, contextualisée, avec droits et communautés de référence lorsque nécessaire.', preuve: 'source sheet' },
	{ titre: 'Grammaire explicite', texte: 'La relation entre source et système doit être formulée, dessinée et défendable.', preuve: 'grammar map' },
	{ titre: 'Système computationnel', texte: 'Le projet contient un comportement, des règles ou paramètres réellement opérants.', preuve: 'code / logic' },
	{ titre: 'Mapping perceptible', texte: 'Data et interaction ne sont utilisées que si leur effet est lisible et conceptuellement justifié.', preuve: 'mapping sheet' },
	{ titre: 'Œuvre montrable', texte: 'Le résultat doit exister comme expérience autonome ou interactive, et non comme simple exercice de code.', preuve: 'live / capture' },
	{ titre: 'Robustesse & responsabilité', texte: 'Fallback, reset, lisibilité, accessibilité, droits, déclaration IA si applicable.', preuve: 'preflight' },
	{ titre: 'Archive relançable', texte: 'Code, sources, médias, cartel, README, manifest et identifiant d’édition sont conservés.', preuve: 'archive package' },
];
---

<Layout title="Méthode" description="Le protocole PATRIMOINE.EXE : 10 étapes, la chaîne source → grammaire → système → œuvre, les régimes temporels et les 7 invariants.">
	<h1>Méthode</h1>
	<p class="chapeau">
		Traiter le patrimoine comme un système. Une source patrimoniale est située, documentée puis
		décomposée afin d’en extraire une grammaire opératoire — jamais un simple style.
	</p>

	<section aria-labelledby="t-protocole">
		<h2 id="t-protocole">Le protocole en 10 étapes</h2>
		<ol class="etapes">
			{
				etapes.map((e, i) => (
					<li>
						<span class="mono">{String(i + 1).padStart(2, '0')}</span> {e}
					</li>
				))
			}
		</ol>
	</section>

	<section aria-labelledby="t-chaine">
		<h2 id="t-chaine">La chaîne à tenir</h2>
		<p class="chaine mono">source → grammaire → système → œuvre</p>
		<p>
			Une source réelle avant un style. Un système stable avant une technologie supplémentaire. Un
			mapping justifié avant une API. Une œuvre exposable avant une démonstration de code.
		</p>
	</section>

	<section aria-labelledby="t-regimes">
		<div class="tableau-defile">
			<table class="tableau">
				<caption id="t-regimes">Les quatre régimes temporels</caption>
				<thead>
					<tr><th scope="col">Régime</th><th scope="col">Logique</th><th scope="col">Question à se poser</th></tr>
				</thead>
				<tbody>
					{
						regimes.map((r) => (
							<tr>
								<th scope="row">{r.regime}</th>
								<td>{r.logique}</td>
								<td>{r.question}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section aria-labelledby="t-invariants">
		<h2 id="t-invariants">Les 7 invariants du standard</h2>
		<p>Une édition n’est officielle que si elle respecte sept invariants vérifiables.</p>
		<ol class="invariants">
			{
				invariants.map((inv) => (
					<li>
						<h3>{inv.titre}</h3>
						<p>{inv.texte}</p>
						<p class="preuve mono">Preuve : {inv.preuve}</p>
					</li>
				))
			}
		</ol>
	</section>

	<p class="source">Sources : framework PATRIMOINE.EXE ; livret étudiant Nantes 001 (ESD Nantes, 2026).</p>
</Layout>

<style>
	section {
		margin-bottom: var(--e-6);
	}
	.chapeau {
		font-size: var(--t-s);
		margin-bottom: var(--e-5);
	}
	.etapes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: var(--e-2);
	}
	.etapes li {
		padding: var(--e-3);
		background: var(--c-fond-alt);
		border-radius: var(--r-md);
		font-family: var(--f-titre);
		font-size: var(--t-s);
		font-weight: 600;
	}
	.etapes .mono {
		color: var(--c-primaire);
		font-size: var(--t-petit);
		font-weight: 400;
		margin-right: var(--e-1);
	}
	.chaine {
		font-size: var(--t-s);
		color: var(--c-primaire);
	}
	.invariants {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: var(--e-3);
	}
	.invariants li {
		border-top: 4px solid var(--c-primaire);
		padding-top: var(--e-2);
	}
	.invariants h3 {
		font-size: var(--t-s);
		margin-bottom: var(--e-2);
	}
	.invariants p {
		font-size: var(--t-petit);
		margin-bottom: var(--e-2);
	}
	.preuve {
		color: var(--c-texte-doux);
	}
	.source {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}
</style>
