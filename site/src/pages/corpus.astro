---
// Corpus Nantes 001 : la CITY LAYER du framework (prompt 10).
// Éléments et propriétés repris du livret (section « Nantes comme corpus de recherche ») et du framework.
import Layout from '../layouts/Layout.astro';

const elements = [
	{ nom: 'Passage Pommeraye', proprietes: 'Verticalité, escaliers, balustrades, séquences, répétitions, axes, circulation.' },
	{ nom: 'Île Feydeau / mascarons', proprietes: 'Sérialité, variations dans une famille, façade, rythme, visage/ornement, répétition imparfaite.' },
	{ nom: 'Château des ducs de Bretagne', proprietes: 'Strates, fortification, murs, tours, crénelage, plan, seuils, temporalités historiques.' },
	{ nom: 'Tour LU / héritage industriel', proprietes: 'Ornement, signal urbain, géométrie verticale, couleur, mémoire d’une production.' },
	{ nom: 'Grues et chantiers navals', proprietes: 'Treillis, structure, levage, mouvement, industrie, répétition mécanique.' },
	{ nom: 'Patrimoine arboré', proprietes: 'Donnée géolocalisée, distribution, espèces, densité, âge si disponible, paysage vivant.' },
	{ nom: 'Inventaires locaux', proprietes: null },
	{ nom: 'Mémoire de la traite', proprietes: null, note: 'Piste critique identifiée par le framework.' },
];

const familles = [
	{ famille: 'Géométrie', question: 'Quels axes, angles, modules, proportions ?', traductions: 'Coordonnées, rotations, échelles, contraintes.' },
	{ famille: 'Répétition', question: 'Qu’est-ce qui se répète ? À quel rythme ?', traductions: 'Boucles, grilles, séries, permutations.' },
	{ famille: 'Hiérarchie', question: 'Qu’est-ce qui domine ? Qu’est-ce qui articule ?', traductions: 'Taille, poids, contraste, fréquence.' },
	{ famille: 'Matière', question: 'Quelle texture, densité, irrégularité ?', traductions: 'Bruit, particules, trames, alpha, grain.' },
	{ famille: 'Temporalité', question: 'Y a-t-il un cycle, une transformation, une usure ?', traductions: 'Animation, croissance, disparition, historique.' },
	{ famille: 'Usage / geste', question: 'Comment le corps rencontre-t-il cet élément ?', traductions: 'Interaction, parcours, seuil, proximité.' },
	{ famille: 'Mémoire', question: 'Que raconte la source ? Qu’est-ce qui doit rester visible ?', traductions: 'Archives, traces, couches, données, texte.' },
];
---

<Layout title="Corpus" description="Le corpus Nantes 001 : sources patrimoniales nantaises et familles de traduction computationnelle.">
	<h1>Corpus Nantes 001</h1>
	<p class="chapeau">
		Le territoire n’est pas un décor. Il fournit des sources, des histoires, des formes, des usages
		et des données. Chaque groupe peut choisir un élément proposé ici ou défendre une autre source
		documentée.
	</p>

	<section aria-labelledby="t-elements">
		<h2 id="t-elements">Sources proposées</h2>
		<ul class="elements">
			{
				elements.map((e) => (
					<li>
						<h3>{e.nom}</h3>
						{e.proprietes ? <p>{e.proprietes}</p> : <p class="sans">Propriétés observables à documenter par le groupe qui choisit cette source.</p>}
						{e.note && <p class="note">{e.note}</p>}
					</li>
				))
			}
		</ul>
	</section>

	<section aria-labelledby="t-familles">
		<h2 id="t-familles">Familles de traduction</h2>
		<p>
			Pour chaque source, ces sept familles aident à passer des propriétés observées à des
			traductions computationnelles.
		</p>
		<div class="tableau-defile">
			<table class="tableau">
				<caption class="visuellement-cache">Familles de traduction : questions et traductions possibles</caption>
				<thead>
					<tr><th scope="col">Famille</th><th scope="col">Questions</th><th scope="col">Traductions possibles</th></tr>
				</thead>
				<tbody>
					{
						familles.map((f) => (
							<tr>
								<th scope="row">{f.famille}</th>
								<td>{f.question}</td>
								<td>{f.traductions}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<p class="source">Sources : livret étudiant Nantes 001 (ESD Nantes, 2026) ; framework PATRIMOINE.EXE.</p>
</Layout>

<style>
	section {
		margin-bottom: var(--e-6);
	}
	.chapeau {
		font-size: var(--t-s);
		margin-bottom: var(--e-5);
	}
	.elements {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--e-3);
	}
	.elements li {
		padding: var(--e-3);
		border: 2px solid var(--c-texte);
		border-radius: var(--r-lg);
	}
	.elements h3 {
		font-size: var(--t-s);
		margin-bottom: var(--e-2);
	}
	.elements p {
		font-size: var(--t-petit);
		margin: 0;
	}
	.elements .sans,
	.elements .note {
		color: var(--c-texte-doux);
		font-style: italic;
	}
	.elements .note {
		margin-top: var(--e-2);
	}
	.source {
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}
</style>
