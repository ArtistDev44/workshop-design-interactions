---
// En-tête et navigation principale (prompt 04).
const base = import.meta.env.BASE_URL;
const liens = [
	{ href: '', label: 'Accueil' },
	{ href: 'oeuvres/', label: 'Œuvres' },
	{ href: 'catalogue/', label: 'Catalogue' },
	{ href: 'statistiques/', label: 'Statistiques' },
	{ href: 'methode/', label: 'Méthode' },
	{ href: 'corpus/', label: 'Corpus' },
	{ href: 'donnees/', label: 'Données' },
	{ href: 'credits/', label: 'Crédits' },
];
const chemin = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const estActif = (href: string) =>
	href === '' ? chemin === base : chemin.startsWith(`${base}${href}`);
---

<header class="entete">
	<div class="entete__inner">
		<a class="marque" href={base}>
			<span class="marque__nom">PATRIMOINE.EXE</span>
			<span class="marque__edition">Nantes 001</span>
		</a>
		<nav aria-label="Navigation principale">
			<ul>
				{
					liens.map((l) => (
						<li>
							<a href={`${base}${l.href}`} aria-current={estActif(l.href) ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.entete {
		border-bottom: 4px solid var(--c-primaire);
		background: var(--c-fond);
	}
	.entete__inner {
		max-width: var(--largeur-max);
		margin: 0 auto;
		padding: var(--e-3);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--e-3);
	}
	.marque {
		display: flex;
		flex-direction: column;
		color: var(--c-texte);
		text-decoration: none;
		font-family: var(--f-titre);
		line-height: 1;
	}
	.marque__nom {
		font-size: var(--t-m);
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.marque__edition {
		font-family: var(--f-mono);
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
		margin-top: var(--e-1);
	}
	ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--e-1) var(--e-3);
		margin: 0;
		padding: 0;
	}
	nav a {
		display: inline-block;
		padding: var(--e-1) 0;
		color: var(--c-texte);
		text-decoration: none;
		font-size: var(--t-petit);
		border-bottom: 3px solid transparent;
	}
	nav a:hover {
		border-bottom-color: var(--c-tertiaire);
	}
	nav a[aria-current='page'] {
		color: var(--c-primaire);
		border-bottom-color: var(--c-primaire);
		font-weight: 600;
	}
</style>
