---
import { lien } from '../lib/liens';
// Pied de page avec crédits d'édition (prompt 04).
---

<footer class="pied">
	<div class="pied__inner">
		<p>
			<strong>PATRIMOINE.EXE · NTE001</strong> — édition pilote STUDIO, ESD Nantes, B3 Design,
			9, 10 &amp; 12 novembre 2026. Intervenant : Kamel Ghabte.
		</p>
		<p class="mono">source → grammaire → système → œuvre</p>
		<p><a href={lien(`jeu/`)}>Jouer à « Nantes en régulation »</a> · <a href={lien(`credits/`)}>Crédits, sources et usage de l'IA</a></p>
	</div>
</footer>

<style>
	.pied {
		border-top: 1px solid var(--c-filet);
		background: var(--c-fond-alt);
		font-size: var(--t-petit);
		color: var(--c-texte-doux);
	}
	.pied__inner {
		max-width: var(--largeur-max);
		margin: 0 auto;
		padding: var(--e-4) var(--e-3);
	}
	.pied p {
		margin-bottom: var(--e-2);
	}
</style>
